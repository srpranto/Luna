# ==============================================================================
# LUNA ENVIRONMENT CONFIGURATION (100% FREE ON VERCEL)
# ==============================================================================

# [REQUIRED FOR VERCEL DEPLOYMENT] 100% Free PostgreSQL Database Connection
# Vercel Serverless Lambdas require a shared PostgreSQL database so strangers can match.
# 1-Click Setup: In Vercel Dashboard -> Storage -> Create Database -> Neon (Free Tier)
# Or use free Supabase / Neon.tech:
DATABASE_URL=postgres://user:password@ep-cool-project-123.us-east-2.aws.neon.tech/neondb?sslmode=require

# App URL for metadata and OpenGraph link previews
NEXT_PUBLIC_APP_URL=https://your-luna-app.vercel.app

# [OPTIONAL] Secret for signing Ephemeral Station JWTs (uses secure fallback if omitted)
LUNA_JWT_SECRET=any_long_random_secret_string_for_station_tokens

# [OPTIONAL] Free Serverless Redis REST Bus for instant multi-region fanout (10k cmds/day free)
# In Vercel Dashboard -> Storage -> Upstash Redis (Free)
# If omitted, Luna automatically falls back to in-memory/SQL polling with zero errors!
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-rest-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# [OPTIONAL] Vercel Cron Secret for automatic database garbage collection
CRON_SECRET=your_cron_cleanup_secret

